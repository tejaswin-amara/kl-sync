{
  "name": "kl-sync",
  "version": "2.4.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:links": "npx --yes tsx scripts/verify-links.ts --offline --strict",
    "test:links": "npx --yes tsx --test tests/verify-links.test.ts tests/challenger-pipeline-adversarial.test.ts",
    "test": "KL_SYNC_DEMO_MODE=true KL_SYNC_AI_MODE=offline npx --yes tsx --test src/**/*.test.ts",
    "test:api": "KL_SYNC_DEMO_MODE=true KL_SYNC_AI_MODE=offline npx --yes tsx --test src/e2e/tier1-feature-coverage.test.ts src/e2e/tier2-boundary-corner-cases.test.ts src/e2e/tier3-cross-feature-combinations.test.ts src/e2e/tier4-real-world-scenarios.test.ts",
    "verify": "npm run typecheck && npm run verify:links && npm run test:links"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.44",
    "ai": "^7.0.70",
    "cap-widget": "^0.1.57",
    "capjs-core": "^0.1.1",
    "cheerio": "^1.2.0",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
