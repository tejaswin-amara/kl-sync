# ==============================================================================
# KL-Sync Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: NEVER commit .env.local or actual secrets to Git!
# In production, set these via Vercel Dashboard: Settings -> Environment Variables.
# ==============================================================================

# --- REQUIRED IN PRODUCTION ---

# AES-256-GCM encryption secret for student ERP sessions.
# Generate a secure 32+ character hex string:
#   openssl rand -hex 32
SESSION_SECRET=

# --- OPTIONAL: AI COPILOT ---

# OpenAI API key for the context-aware AI Chat Assistant.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- REQUIRED IN PRODUCTION: CAPTCHA REPLAY PROTECTION ---

# CapJS proof-of-work challenge verification secret. If omitted, CAP_SECRET
# falls back to SESSION_SECRET. Use a separate random secret when possible.
# Generate: openssl rand -hex 32
CAP_SECRET=

# Upstash Redis REST is REQUIRED for production CAPTCHA nonce consumption
# and single-use login-token replay protection. Without it, browser
# verification fails closed. It also backs distributed rate limits.
# Dashboard: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OPTIONAL: PROXY HEADERS ---

# Set to 'true' to trust X-Forwarded-For / X-Real-IP for rate limiting.
# Auto-enabled on Vercel (VERCEL=1). Required for correct IP extraction
# behind any reverse proxy.
TRUST_PROXY_HEADERS=
