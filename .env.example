# ==============================================================================
# KL-Sync Environment Variables
# ==============================================================================
# IMPORTANT: DO NOT commit actual secrets or credentials to GitHub!
# Set these in your Vercel Project Dashboard: Settings -> Environment Variables.

# [REQUIRED IN PRODUCTION]
# AES-256-GCM encryption secret for student ERP sessions.
# Generate a secure 32+ character string (e.g. `openssl rand -hex 32`):
SESSION_SECRET=

# [OPTIONAL - AI Copilot]
# Required only if enabling AI Assistant Chat features:
OPENAI_API_KEY=

# [OPTIONAL - CAPTCHA OCR]
# OCR Space API key for server-side fallback captcha solving:
# Free key at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=

# [OPTIONAL - CapJS Widget]
# Custom secret for CapJS challenge verification:
CAP_SECRET=

# [OPTIONAL - Upstash Redis Rate Limiting]
# Optional distributed rate limiting across serverless edge functions:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

